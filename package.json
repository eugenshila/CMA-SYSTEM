{
  "name": "cma-system",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.cjs",
  "description": "CMA Member Management, Welfare, Contributions, SDP/Sacco, Loans and Shares Management System",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p ${PORT:-3000}",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:local": "node scripts/local-db.mjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "desktop:dev": "node scripts/make-icons.mjs && electron .",
    "desktop:icons": "node scripts/make-icons.mjs",
    "desktop:prepare": "node scripts/prepare-standalone.mjs",
    "dist": "npm run build && npm run desktop:prepare && npm run desktop:icons && electron-builder --publish never",
    "dist:win": "npm run build && npm run desktop:prepare && npm run desktop:icons && electron-builder --win --publish never",
    "dist:dir": "npm run build && npm run desktop:prepare && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.545.0",
    "next": "15.5.25",
    "pdfkit": "^0.17.2",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
