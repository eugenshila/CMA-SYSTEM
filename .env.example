# ------------------------------------------------------------------
# CMA SYSTEM — local development environment
# Copy to .env.local and change the secrets before deploying.
# ------------------------------------------------------------------

# PostgreSQL (Railway in production, PGlite-backed server in local dev)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Application secrets — REQUIRED. Rotate in production.
AUTH_SECRET=replace-with-a-long-random-string
ENCRYPTION_KEY=replace-with-64-hex-characters

APP_NAME="CMA Management System"
APP_URL=http://localhost:3000
NODE_ENV=development

# Payment / notification providers (leave empty in development: sandbox mode)
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORT_CODE=
MPESA_PASSKEY=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke
MPESA_CALLBACK_URL=

# Cloud file storage (optional). When unset, files are stored on local disk
# under ./storage/uploads and served through an authenticated route.
CLOUDINARY_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Seed / demo
SEED_DEMO_DATA=true

# Node connection pool size (Railway/production PostgreSQL: 8-10 is fine).
# When DATABASE_URL points at localhost the pool is FORCED to 1 no matter what
# this says, because the bundled PGlite dev server is single-threaded WASM and
# every extra socket only adds contention. Do NOT raise PGPOOL_MAX as a
# workaround for slow requests — it makes things worse against PGlite.
PGPOOL_MAX=8

# Port of the local PGlite-backed PostgreSQL server started by `npm run dev:all`
# (scripts/local-db.mjs). Must match the port in DATABASE_URL. Change both
# together if 5432 is already taken on your machine (e.g. a local PostgreSQL).
PGPORT_LOCAL=5432
